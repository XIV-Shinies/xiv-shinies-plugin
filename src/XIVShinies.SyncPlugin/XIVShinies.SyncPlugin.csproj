<?xml version="1.0" encoding="utf-8"?>
<!--
  Sdk="Dalamud.NET.Sdk/15.0.0" selects the MSBuild SDK for the whole build; "15" is Dalamud API
  level 15. The SDK:
    - sets the target framework (net10.0-windows), so this file never sets <TargetFramework>,
    - references the Dalamud, ImGui, Lumina and FFXIVClientStructs libraries from the local
      XIVLauncher dev install (%AppData%\XIVLauncher\addon\Hooks\dev),
    - merges XIVShinies.SyncPlugin.json with build-derived fields into the packaged manifest, and
    - runs DalamudPackager to emit a loadable plugin zip on Release builds.
-->
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!--
      The release version. The SDK copies it into the packaged manifest as "AssemblyVersion",
      normalized to four parts.
    -->
    <Version>0.9.0</Version>

    <!--
      The manifest's "RepoUrl" is set in XIVShinies.SyncPlugin.json; the SDK does not derive it
      from this property.
    -->
    <PackageProjectUrl>https://github.com/XIV-Shinies/xiv-shinies-plugin</PackageProjectUrl>

    <!-- SPDX license id; matches the repo's MIT LICENSE file. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- A Dalamud plugin, not a NuGet package, so `dotnet pack` is off. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Lets the xUnit project see `internal` members. A helper is internal when a public one would
    invite a wrong call (see PayloadCaps' dictionary overload, which caps without retracting
    completeness claims) but its rules still need direct tests.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="XIVShinies.SyncPlugin.Tests" />
  </ItemGroup>

  <!--
    The packaged manifest merges two sources:
      1) XIVShinies.SyncPlugin.json in this folder: the hand-written fields, such as Name,
         Punchline, Description, Tags, RepoUrl, IconUrl and ImageUrls. It is strict JSON, so it
         carries no comments.
      2) Fields the SDK injects: InternalName (the assembly name), AssemblyVersion (from
         <Version> above), and DalamudApiLevel (from the SDK version).
    Dalamud reads the merged bin/Release/XIVShinies.SyncPlugin.json and its copy in the zip.
  -->

  <!--
    Dalamud shows a dev plugin's icon only when images/icon.png sits next to the loaded DLL, and
    DalamudPackager takes it from there for release zips. The icon is hand-made: Dalamud's AI policy
    disallows AI-generated icons.
  -->
  <ItemGroup>
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
