<!-- Plain Microsoft.NET.Sdk: tests don't ship as a Dalamud plugin. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Must match the plugin's target framework, which the Dalamud SDK sets: a project can reference
      another only on a compatible framework.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>

    <!-- The Dalamud SDK turns this on for the plugin; this project opts in itself. -->
    <Nullable>enable</Nullable>

    <LangVersion>latest</LangVersion>

    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XIVShinies.SyncPlugin\XIVShinies.SyncPlugin.csproj" />
  </ItemGroup>

  <!--
    Sample game-window values the Crucible window readers are tested against (see the README beside
    them), copied to the same Crucible\Fixtures path in the build output, where WindowFixture loads
    them by name. Update, not Include: the SDK already lists every file it does not compile as None.
  -->
  <ItemGroup>
    <None Update="Crucible\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The plugin manifest and repo.json, copied to StoreListing in the build output, where
    StoreListingTests reads them. Include, not Update: both live outside this project.
  -->
  <ItemGroup>
    <None Include="..\..\src\XIVShinies.SyncPlugin\XIVShinies.SyncPlugin.json"
          Link="StoreListing\XIVShinies.SyncPlugin.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\repo.json"
          Link="StoreListing\repo.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The repository README, copied to Readme in the build output, where ReadmeTests reads it. -->
  <ItemGroup>
    <None Include="..\..\README.md"
          Link="Readme\README.md"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
